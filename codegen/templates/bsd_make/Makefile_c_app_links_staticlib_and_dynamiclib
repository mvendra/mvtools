.PHONY : all prepfolders clean compile link

# PLUMBING
COMPILER=gcc
LINKER=${COMPILER}

# AUTOCONF PREP
BASE=../../..
BASE_SRC=${BASE}/src
BASE_TMP=${BASE}/tmp
BASE_OUT=${BASE}/out
BASE_DEP=${BASE}/dep

# PROJECT SETUP
# For this sample/template Makefile to correctly link with staticlib and dynamiclib, you'd need to build and deploy them into ${BASE_DEP}/${PLAT}/${MODE} (see below/further) - and also create the soname symlink for the dynamic lib inside of it as well
OUTNAME=sampleapp
SRC=main.c
INCLUDES=-I${BASE_SRC}
CFLAGS=-std=c23 -m64 -Wall -Wextra -Wconversion -Werror -pedantic -fPIC -finput-charset=utf-8 -fexec-charset=utf-8
LDFLAGS=-L${BASE_DEP}/${PLAT}/${MODE}
LIBS=-lstaticlib -ldynamiclib
LIBS_AFTER_ASAN=
POSTBUILD=

# DEFAULTS
PLAT=freebsd
MODE=release # for debug mode, use 'make MODE=debug'

# PLAT FLAGS
UNAME_S != uname -s

# FREEBSD
.if ${UNAME_S} == "FreeBSD"
    PLAT=freebsd
.endif

# DEBUG
.if ${MODE} == "debug"
    CFLAGS+=-g -fsanitize=address -D_GLIBCXX_DEBUG
    LIBS+=-lasan
.endif

# RELEASE
.if ${MODE} == "release"
    CFLAGS+=-O2 -DNDEBUG
    POSTBUILD=strip -g ${OUTNAME_FULL}
.endif

# LIBS AFTER ASAN
LIBS+=${LIBS_AFTER_ASAN}

# AUTOCONF COMPLETE
TMP_FULL=${BASE_TMP}/${PLAT}/${MODE}
OUT_FULL=${BASE_OUT}/${PLAT}/${MODE}
.for s in ${SRC}
    ALL_OBJS+=${TMP_FULL}/${s:S/\//_/g:S/.c$/.o/}
.endfor
OUTNAME_FULL=${OUT_FULL}/${OUTNAME}

# TARGET: ALL
all: prepfolders compile link

# TARGET: PREPFOLDERS
prepfolders:
	@mkdir -p ${TMP_FULL}
	@mkdir -p ${OUT_FULL}

# TARGET: COMPILE
compile:
.for s in ${SRC}
	${COMPILER} ${INCLUDES} ${CFLAGS} -c ${BASE_SRC}/${s} -o ${TMP_FULL}/${s:S/\//_/g:S/.c$/.o/}
.endfor

# TARGET: LINK
link:
	${LINKER} -o ${OUTNAME_FULL} ${ALL_OBJS} ${LDFLAGS} ${LIBS} -Wl,-rpath,"${BASE_DEP}/${PLAT}/${MODE}"
	${POSTBUILD}

# TARGET: CLEAN
clean:
.for o in ${ALL_OBJS}
	rm ${o}
.endfor
	rm ${OUTNAME_FULL}
