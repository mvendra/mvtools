.PHONY : all prepfolders clean compile link

# PLUMBING
COMPILER=gcc
LINKER=${COMPILER}

# AUTOCONF PREP
BASE=../../..
BASE_SRC=${BASE}/src
BASE_TMP=${BASE}/tmp
BASE_OUT=${BASE}/out
BASE_DEP=${BASE}/dep

# PROJECT SETUP
# To link to this library, pass [-Wl,-rpath,"."] to your linker (during the linking step, particularly), plus -lthe-final-so-name (i.e. $SONAME in this particular Makefile - see below/further)
# This will tell the application executable to search its own current path (".") for the library's soname. You could also pass "../../../dep/freebsd/my_library" for example.
OUTNAME=dynamiclib
SO_SUFFIX=-dev.1
SRC=subfolder/second.c
INCLUDES=-I${BASE_SRC}
CFLAGS=-std=c23 -m64 -Wall -Wextra -Wconversion -Werror -pedantic -fPIC -finput-charset=utf-8 -fexec-charset=utf-8
LDFLAGS=
LIBS=
LIBS_AFTER_ASAN=
POSTBUILD=

# DEFAULTS
PLAT=freebsd
MODE=release # for debug mode, use 'make MODE=debug'

# PLAT FLAGS
UNAME_S != uname -s

# FREEBSD
.if ${UNAME_S} == "FreeBSD"
    PLAT=freebsd
.endif

# DEBUG
.if ${MODE} == "debug"
    CFLAGS+=-g -fsanitize=address -D_GLIBCXX_DEBUG
    LIBS+=-lasan
.endif

# RELEASE
.if ${MODE} == "release"
    CFLAGS+=-O2 -DNDEBUG
    POSTBUILD=strip -g ${OUTNAME_FULL}
.endif

# LIBS AFTER ASAN
LIBS+=${LIBS_AFTER_ASAN}

# AUTOCONF COMPLETE
TMP_FULL=${BASE_TMP}/${PLAT}/${MODE}
OUT_FULL=${BASE_OUT}/${PLAT}/${MODE}
.for s in ${SRC}
    ALL_OBJS+=${TMP_FULL}/${s:S/\//_/g:S/.c$/.o/}
.endfor
OUTNAME_FULL=${OUT_FULL}/lib${OUTNAME}.so
SONAME=lib${OUTNAME}${SO_SUFFIX}.so

# TARGET: ALL
all: prepfolders compile link

# TARGET: PREPFOLDERS
prepfolders:
	@mkdir -p ${TMP_FULL}
	@mkdir -p ${OUT_FULL}

# TARGET: COMPILE
compile:
.for s in ${SRC}
	${COMPILER} ${INCLUDES} ${CFLAGS} -c ${BASE_SRC}/${s} -o ${TMP_FULL}/${s:S/\//_/g:S/.c$/.o/}
.endfor

# TARGET: LINK
link:
	${LINKER} -o ${OUTNAME_FULL} -shared ${ALL_OBJS} -Wl,-soname,${SONAME} ${LDFLAGS} ${LIBS}
	${POSTBUILD}

# TARGET: CLEAN
clean:
.for o in ${ALL_OBJS}
	rm ${o}
.endfor
	rm ${OUTNAME_FULL}
